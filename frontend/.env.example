# ═════════════════════════════════════════════════════════════════════════════
# GOD'S EYE FOR BUSINESS — FRONTEND ENVIRONMENT CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Cesium Ion Access Token (Optional)
# Sign up for a free personal account at https://ion.cesium.com/ to obtain your token.
# Providing this token grants access to Cesium Ion 3D world terrain and satellite assets.
# If left blank or unset, the application runs seamlessly on keyless geospatial basemaps
# without triggering the default access token warning banner overlay.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_CESION_ION_TOKEN=

# Backend FastAPI URL
# Default Next.js rewrites proxy /api/* requests directly to http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
