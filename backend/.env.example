# ==============================================================================
# God's Eye for Business — Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL + PostGIS in production, SQLite fallback in local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/godseye
# DATABASE_URL=sqlite:///./business_intel.db

# AI Engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Live Search & Discovery APIs
SERPAPI_API_KEY=your_serpapi_key_here
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=25

# Rate Limiting & Concurrency Controls
REQUEST_TIMEOUT=20.0
MAX_CONCURRENT_REQUESTS=10
NEWS_POLL_INTERVAL=3600
CACHE_TTL=86400

# Optional OSINT & Data Feeds
NEWS_API_KEY=
REDIS_URL=redis://localhost:6379/0
ENABLE_PASSIVE_DNS=true
ENABLE_SECURITY_HEADERS=true

# Frontend Cesium 3D Globe Token (Optional - keyless fallback active if blank)
NEXT_PUBLIC_CESIUM_ION_TOKEN=
